cabal-version:      3.12
name:               tungsten-engine
version:            0.1.0.0
synopsis:           Haskell port of the Tungsten Wolfram expression engine
description:
  An incremental Haskell port of Tungsten Engine with immutable Wolfram
  expressions, FullForm and InputForm parsing, deterministic and session
  evaluation, structural notebooks, Wolfram installation discovery and kernel
  execution, a REPL, a JSON-first command line, and a JSON-lines protocol.
license:            MIT-0
author:             Tungsten contributors
maintainer:         Tungsten contributors
category:           Language
build-type:         Simple
extra-source-files:
  README.md
  docs/haskell-port.md
tested-with:        GHC == 9.12.4

common common-settings
  default-language: GHC2021
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns

library
  import:          common-settings
  hs-source-dirs:  haskell/src
  exposed-modules:
    Tungsten.Cli
    Tungsten.Discovery
    Tungsten.Evaluate
    Tungsten.Expression
    Tungsten.Frontend
    Tungsten.Json
    Tungsten.Kernel
    Tungsten.Licensing
    Tungsten.Notebook
    Tungsten.Parser
    Tungsten.Repl
    Tungsten.Session
    Tungsten.WolframString
  build-depends:
    base       >= 4.21 && < 4.22,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.7  && < 0.8,
    directory  >= 1.3  && < 1.4,
    filepath   >= 1.5  && < 1.6,
    parsec     >= 3.1  && < 3.2,
    process    >= 1.6  && < 1.7,
    text       >= 2.1  && < 2.2,
    time       >= 1.12 && < 1.15

executable tungsten-hs
  import:          common-settings
  hs-source-dirs:  haskell/app
  main-is:         Main.hs
  build-depends:
    base            >= 4.21 && < 4.22,
    text            >= 2.1  && < 2.2,
    tungsten-engine

test-suite tungsten-engine-test
  import:          common-settings
  type:            exitcode-stdio-1.0
  hs-source-dirs:  haskell/test
  main-is:         Main.hs
  build-depends:
    base            >= 4.21 && < 4.22,
    bytestring      >= 0.12 && < 0.13,
    containers      >= 0.7  && < 0.8,
    directory       >= 1.3  && < 1.4,
    text            >= 2.1  && < 2.2,
    tungsten-engine
