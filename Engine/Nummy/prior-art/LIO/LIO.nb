           "]"}]}], "\n", "\t", "]"}]}], "\n", "]"}], "\n", ")"}]}], ";"}], 
   "\n", "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"LIO", "[", 
       RowBox[{"s1_", ",", "l_", ",", "f_"}], "]"}], "\[LessEqual]", 
      RowBox[{"LIO", "[", 
       RowBox[{"s2_", ",", "m_", ",", "g_"}], "]"}]}], "^:=", 
     RowBox[{"(", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"LIO", "[", 
          RowBox[{"s1", ",", "l", ",", "f"}], "]"}], "==", 
         RowBox[{"LIO", "[", 
          RowBox[{"s2", ",", "m", ",", "g"}], "]"}]}], ",", 
        RowBox[{"Return", "[", "True", "]"}], ",", "\n", "\n", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"s1", "<", "0"}], "&&", 
           RowBox[{"s2", "\[GreaterEqual]", "0"}]}], ",", 
          RowBox[{"Return", "[", "True", "]"}], ",", "\n", "\t", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"s1", ">", "0"}], "&&", 
             RowBox[{"s2", "\[LessEqual]", "0"}]}], ",", 
            RowBox[{"Return", "[", "False", "]"}], ",", "\n", "\t\t", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"s1", "<", "0"}], "&&", 
               RowBox[{"s2", "<", "0"}]}], ",", "\n", "\t\t\t", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"l", ">", "m"}], ",", 
                RowBox[{"Return", "[", "True", "]"}], ",", "\n", "\t\t\t\t", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"l", "<", "m"}], ",", 
                  RowBox[{"Return", "[", "False", "]"}], ",", "\n", 
                  "\t\t\t\t\t", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"f", "<", "g"}], ",", 
                    RowBox[{"Return", "[", "False", "]"}], ",", 
                    RowBox[{"Return", "[", "True", "]"}]}], "]"}]}], "\n", 
                 "\t\t\t\t", "]"}]}], "\n", "\t\t\t", "]"}], ",", "\n", 
              "\t\t", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                 RowBox[{"If", " ", "s1"}], "\[GreaterEqual]", "0"}], " ", "&&",
                 " ", 
                RowBox[{"s2", "\[GreaterEqual]", "0"}]}], "*)"}], "\n", 
              "\t\t\t", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"l", ">", "m"}], ",", 
                RowBox[{"Return", "[", "False", "]"}], ",", "\n", "\t\t\t\t", 
                
                RowBox[{"If", "[", 
