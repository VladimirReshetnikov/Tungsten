}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "\[FilledDiamond] ",
 StyleBox["FromLIO[ ",
  FontWeight->"Bold"],
 StyleBox["LIO[sign, level, index] ", "Text",
  FontWeight->"Bold"],
 StyleBox["] :",
  FontWeight->"Bold"],
 " "
}], "Subsubsection",
 CellChangeTimes->{{3.803726630690312*^9, 3.8037266440654*^9}, {
  3.803726679114217*^9, 3.803726680544116*^9}, {3.803726732960436*^9, 
  3.803726741556506*^9}, {3.803727858153638*^9, 3.803727859567487*^9}}],

Cell[TextData[{
 "The ",
 StyleBox["FromLIO[LIO[sign,level,index]]",
  FontWeight->"Bold"],
 " function takes any ",
 StyleBox["LIO[sign, level, index] ",
  FontWeight->"Bold"],
 "object as input and converts it into a floating-point number if it does not \
overflow. If it overflows in normal floating-point notation, the ",
 StyleBox["PowerForm[] ",
  FontWeight->"Bold"],
 "is invoked automatically, and a ",
 StyleBox["level-index format",
  FontSlant->"Italic"],
 " of the number in ",
 StyleBox["base 10",
  FontSlant->"Italic"],
 " is returned."
}], "Text",
 CellChangeTimes->{{3.803726689659196*^9, 3.8037268295292187`*^9}, {
  3.803726960508477*^9, 3.803726962799971*^9}, {3.803727015661664*^9, 
  3.803727084240054*^9}, {3.803748537898086*^9, 3.803748540653636*^9}}],

