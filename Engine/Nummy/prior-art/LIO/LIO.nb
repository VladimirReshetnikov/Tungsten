 CellChangeTimes->{{3.803730168028363*^9, 3.803730177429274*^9}, 
   3.803730219881194*^9, 3.803730640183779*^9}],

Cell[TextData[{
 "\nWe can now successfully ",
 StyleBox["compare huge Power Towers",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " without the problem of overflow, which might not be possible till date \
using normal computers or most other calculators so easily."
}], "Text",
 CellChangeTimes->{{3.803730642725037*^9, 3.803730728635898*^9}, {
  3.8037307627702103`*^9, 3.8037307675508432`*^9}, {3.803748772512185*^9, 
