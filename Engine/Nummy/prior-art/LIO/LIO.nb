Cell[BoxData[
 RowBox[{"PowerForm", "[", 
  RowBox[{"LIO", "[", 
   RowBox[{"1", ",", "14", ",", "0.677"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.8037275716556683`*^9, 3.803727600249757*^9}, {
  3.803727632581703*^9, 3.8037276605312023`*^9}},
 CellLabel->"In[37]:="],

Cell[BoxData[
 SuperscriptBox["\<\"10\"\>", 
  SuperscriptBox["\<\"10\"\>", 
   SuperscriptBox["\<\"10\"\>", 
    SuperscriptBox["\<\"10\"\>", 
     SuperscriptBox["\<\"10\"\>", 
      SuperscriptBox["\<\"10\"\>", 
       SuperscriptBox["\<\"10\"\>", 
        SuperscriptBox["\<\"10\"\>", 
         SuperscriptBox["\<\"10\"\>", 
          SuperscriptBox["\<\"10\"\>", 
           SuperscriptBox["\<\"10\"\>", 
            SuperscriptBox["\<\"10\"\>", 
             
             SuperscriptBox["\<\"10\"\>", 
              "0.43859864995833275`"]]]]]]]]]]]]]], "Output",
 CellChangeTimes->{3.803727668219925*^9, 3.803733381084457*^9, 
  3.803749624982892*^9},
 CellLabel->"Out[37]="]
}, Open  ]],

