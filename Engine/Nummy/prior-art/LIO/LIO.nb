Cell[CellGroupData[{

Cell["A Look into the Backend", "Section",
 CellChangeTimes->{{3.802186221820878*^9, 3.8021862228082314`*^9}, {
  3.802187309884531*^9, 3.8021873367169733`*^9}, {3.802187387379855*^9, 
  3.802187429405521*^9}, {3.8037297709080477`*^9, 3.803729775037126*^9}, {
  3.803729879202919*^9, 3.8037299067876472`*^9}, {3.8037329148054113`*^9, 
  3.803732919024048*^9}}],

Cell[TextData[{
 "The Addition and Subtraction operations were implemented by forming three \
",
 StyleBox["Recursive Functions",
  FontSlant->"Italic"],
 ", as suggested by the original algorithm in the paper \
\[OpenCurlyDoubleQuote]",
 StyleBox["Level-Index Arithmetic Operations\[CloseCurlyDoubleQuote]",
  FontSlant->"Italic"],
 " by Clenshaw and Oliver ",
 ButtonBox[Cell[TextData[StyleBox[ButtonBox["1"],
  FontVariations->{"CompatibilityType"->"Superscript"}]], "Citation",
  Editable->False,
  TaggingRules->{$CellContext`NoteData -> RowBox[{
       RowBox[{"https", ":"}], "//", 
       RowBox[{
         RowBox[{
           RowBox[{
             RowBox[{"dl", ".", "acm", ".", "org"}], "/", "doi"}], "/", 
           "10.1145"}], "/", "62.322429"}]}]}],
  BaseStyle->"Hyperlink",
  ButtonData->"00002B59"]
}], "Text",
 CellChangeTimes->{{3.8021862859717093`*^9, 3.8021862866993*^9}, {
  3.802186780928506*^9, 3.802186861789569*^9}, {3.803732912699401*^9, 
  3.8037330869950314`*^9}, {3.8037331260105886`*^9, 3.803733148404505*^9}, {
  3.803748722416769*^9, 3.8037487432856607`*^9}, {3.803749391234717*^9, 
  3.803749404383938*^9}, {3.803749446213091*^9, 3.803749446245058*^9}}],

Cell["\<\
The Multiplication, Division and Exponentiation operations were implemented \
using the following rules :\
\>", "Text",
 CellChangeTimes->{{3.803733150762967*^9, 3.803733231674324*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "*", "y"}], "=", " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"Log", "[", "x", "]"}], "+", 
    RowBox[{"Log", "[", "y", "]"}]}]]}]], "Text",
 CellChangeTimes->{{3.803733235987013*^9, 3.8037332966946383`*^9}, 
   3.803733364859701*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "/", "y"}], "=", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"Log", "[", "x", "]"}], "-", 
    RowBox[{"Log", "[", "y", "]"}]}]]}]], "Text",
 CellChangeTimes->{{3.80373330293954*^9, 3.8037333384330873`*^9}, 
   3.803733368730118*^9}],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["x", "y"], "=", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"Log", "[", "x", "]"}], "*", "y"}]]}]], "Text",
 CellChangeTimes->{3.80374969196238*^9}],

