Cell[TextData[{
 StyleBox[ButtonBox["Implementation of level-index arithmetic for very large \
numbers",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/groups/-/m/t/2030201"], None},
  ButtonNote->"https://community.wolfram.com/groups/-/m/t/2030201"],
  FontWeight->"Bold"],
 "\n",
 StyleBox["by ",
  FontSlant->"Italic"],
 StyleBox[ButtonBox["Swastik Banerjee",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://community.wolfram.com/web/ss8659"], None},
  ButtonNote->"https://community.wolfram.com/web/ss8659"],
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.8546313859123526`*^9, 3.8546314495419583`*^9}}],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox[" ",
  Background->RGBColor[1, 1, 1]],
 StyleBox["Abstract",
  Background->RGBColor[1, 1, 1]]
}], "Section",
 CellChangeTimes->{{3.8037483395515447`*^9, 3.803748346556596*^9}, {
  3.803750155672254*^9, 3.803750156773218*^9}, {3.803750237063599*^9, 
  3.803750244540062*^9}, {3.803750308906313*^9, 3.803750314030696*^9}}],

Cell["\<\
To represent extremely large real numbers, e.g., Tetrational numbers or huge \
Power Towers, in the ordinary level-index arithmetic format.  Floating-point \
arithmetic is inadequate to represent these kinds of large numbers, as they \
are much bigger than the largest real number that can be represented in the \
Wolfram Language, and hence suffers the problem of overflow. This project \
introduces a new large number format in Mathematica to virtually abolish the \
problem of overflow, and adds support for this new format in many of the \
usual mathematical operations such as +, *, ^ etc.\
\>", "Abstract",
 CellChangeTimes->{{3.802186680026499*^9, 3.802186711462531*^9}, {
  3.803716481911756*^9, 3.80371650391287*^9}, {3.803716549947865*^9, 
  3.803716559161592*^9}}],

Cell[TextData[{
 StyleBox["Try",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["Overflowing",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["Mathematica",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["Ever",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["Again",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["!!",
  FontSize->16,
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.803734068175448*^9, 3.803734081444799*^9}},
 FontWeight->Plain]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduction to Level-Index Arithmetic", "Section",
 CellChangeTimes->{{3.802186221820878*^9, 3.8021862228082314`*^9}, {
  3.802187309884531*^9, 3.8021873367169733`*^9}, {3.803718825806757*^9, 
  3.803718831301463*^9}, {3.803719180199029*^9, 3.803719188087401*^9}}],

Cell["\<\
In the field of scientific computation generally and especially in \
experimental computing which is often at the heart of simulation and modeling \
problems, the availability of a robust system of arithmetic offers many \
advantages. Many such computational problems are prone to failure due to \
overflow or underflow or to a lack of advance knowledge of a suitable scaling \
for the problem. \
\>", "Text",
 CellChangeTimes->{{3.8021862859717093`*^9, 3.8021862866993*^9}, {
   3.802186780928506*^9, 3.802186861789569*^9}, {3.8037193643652573`*^9, 
   3.803719378733344*^9}, 3.8037195147145452`*^9, 3.803719572409355*^9}],

Cell[TextData[{
 "For example, if we wanted to compute the following, ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " would throw an ",
 StyleBox["Overflow error:\n",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.8037195817444353`*^9, 3.8037196826666527`*^9}, 
   3.803719946829808*^9, 3.803720110501896*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  SuperscriptBox["8", 
   SuperscriptBox["88", "888"]], "<", 
  SuperscriptBox["128", 
   SuperscriptBox["48", "1024"]], " "}]], "Input",
 CellChangeTimes->{{3.803719949380436*^9, 3.803719994836134*^9}, {
  3.803721684421768*^9, 3.803721711376135*^9}},
 CellLabel->"In[34]:="],

Cell[BoxData[
 TemplateBox[{
  "General", "ovfl", "\"Overflow occurred in computation.\"", 2, 34, 1, 
   23308362721132737795, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellChangeTimes->{3.80372000538865*^9, 3.8037201648683167`*^9, 
  3.803733380650313*^9, 3.8037495990377827`*^9},
 CellLabel->"During evaluation of In[34]:="],

Cell[BoxData[
 TemplateBox[{
  "General", "ovfl", "\"Overflow occurred in computation.\"", 2, 34, 2, 
   23308362721132737795, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellChangeTimes->{3.80372000538865*^9, 3.8037201648683167`*^9, 
  3.803733380650313*^9, 3.8037495990601187`*^9},
 CellLabel->"During evaluation of In[34]:="],

Cell[BoxData[
 RowBox[{
  RowBox[{"Overflow", "[", "]"}], "<", 
  RowBox[{"Overflow", "[", "]"}]}]], "Output",
 CellChangeTimes->{3.803733380785553*^9, 3.803749599078919*^9},
 CellLabel->"Out[34]="]
}, Open  ]],

Cell[TextData[{
 "\nThe use of a computer arithmetic system which is free of these drawbacks \
would clearly alleviate any such difficulties.\nOne such arithmetic is the ",
 Cell[BoxData[
  ButtonBox[
   TagBox["\<\"Level-index Arithmetic\"\>",
    MouseAppearanceTag["LinkHand"],
    DefaultBaseStyle->Dynamic[
      If[
       CurrentValue["MouseOver"], {"HyperlinkActive"}, {"Hyperlink"}]]],
   BaseStyle->{"Hyperlink", ShowStringCharacters -> False},
   ButtonData->{
     URL["https://en.wikipedia.org/wiki/Symmetric_level-index_arithmetic"], 
     None},
   ButtonNote->
    "https://en.wikipedia.org/wiki/Symmetric_level-index_arithmetic"]]],
 " introduced by ",
 StyleBox["Clenshaw",
  FontSlant->"Italic"],
 " and ",
 StyleBox["Olver",
  FontSlant->"Italic"],
 " ",
 ButtonBox[Cell[TextData[StyleBox[ButtonBox["1"],
  FontVariations->{"CompatibilityType"->"Superscript"}]], "Citation",
  Editable->False,
  TaggingRules->{$CellContext`NoteData -> RowBox[{
       RowBox[{"https", ":"}], "//", 
       RowBox[{
         RowBox[{
           RowBox[{
             RowBox[{"dl", ".", "acm", ".", "org"}], "/", "doi"}], "/", 
           "10.1145"}], "/", "62.322429"}]}]}],
  BaseStyle->"Hyperlink",
  ButtonData->"00002B59"],
 " in 1984. \n\nThe idea of the level - index system is to represent a non - \
negative ",
 Cell[BoxData[
  ButtonBox[
   TagBox["\<\"real number\"\>",
    MouseAppearanceTag["LinkHand"],
    DefaultBaseStyle->Dynamic[
      If[
       CurrentValue["MouseOver"], {"HyperlinkActive"}, {"Hyperlink"}]]],
   BaseStyle->{"Hyperlink", ShowStringCharacters -> False},
   ButtonData->{
     URL["https://en.wikipedia.org/wiki/Real_number"], None},
   ButtonNote->"https://en.wikipedia.org/wiki/Real_number"]]],
 "  ",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "  as"
}], "Text",
 CellChangeTimes->{{3.8037200818573093`*^9, 3.803720101276094*^9}, {
  3.803720954426393*^9, 3.803720971091416*^9}, {3.80372191538988*^9, 
  3.803721919621904*^9}, {3.803722012563044*^9, 3.803722026368597*^9}, {
  3.803723898286068*^9, 3.8037238982900457`*^9}, {3.803724031812639*^9, 
  3.80372406873621*^9}, {3.803724249482689*^9, 3.803724266859167*^9}, {
  3.803733086951644*^9, 3.8037330869595118`*^9}}],

Cell[BoxData[
 StyleBox[
  RowBox[{"     ", 
   RowBox[{"X", "=", 
    SuperscriptBox["\[ExponentialE]", 
     SuperscriptBox["\[ExponentialE]", 
      SuperscriptBox["\[ExponentialE]", 
       SuperscriptBox["...", 
        SuperscriptBox["\[ExponentialE]", "f"]]]]]}]}],
  FontWeight->"Bold"]], "Text",
 CellChangeTimes->{
  3.80372088384048*^9, {3.803720990256055*^9, 3.803720990847629*^9}}],

Cell[TextData[{
 "where 0 ",
 Cell[BoxData[
  FormBox["\[LessEqual]", TraditionalForm]]],
 " ",
 StyleBox["f",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox["\[LessEqual]", TraditionalForm]]],
 " 1 and the process of exponentiation is performed ",
 StyleBox["l",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " times, with ",
 StyleBox["l",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "\[GreaterEqual] 0 . \n",
 StyleBox["l",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " and ",
 StyleBox["f ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " are the ",
 StyleBox["level",
  FontSlant->"Italic"],
 " and ",
 StyleBox["index",
  FontSlant->"Italic"],
 " of ",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " respectively.\n"
}], "Text",
 CellChangeTimes->{{3.8037210035283737`*^9, 3.8037210683815947`*^9}, {
   3.803721116351985*^9, 3.8037211321112623`*^9}, {3.803721317537448*^9, 
   3.803721325212768*^9}, {3.803721360188094*^9, 3.803721360415683*^9}, 
   3.803721405274879*^9, {3.803721456630777*^9, 3.803721460483717*^9}, 
   3.803721638672097*^9, {3.803721695473702*^9, 3.8037217164896793`*^9}, {
   3.803721750374465*^9, 3.803721757286516*^9}}],

Cell[TextData[{
 "For example, \n",
 StyleBox["X",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " =  1234567   =   ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    SuperscriptBox["\[ExponentialE]", 
     SuperscriptBox["\[ExponentialE]", "0.9711308"]]], TraditionalForm]]]
}], "Text",
 CellChangeTimes->{{3.8037208945370283`*^9, 3.803720911877852*^9}, {
  3.8037215069632874`*^9, 3.80372159193729*^9}}],

Cell["\<\

Level-index Arithmetic is closed under the four basic arithmetic operations \
(apart from division by zero, of course) and is therefore free of \
overflow.The arithmetic system allows very large numbers which may not be \
representable in a conventional floating-point system to be used during \
interim computation while still returning meaningful results.\
\>", "Text",
 CellChangeTimes->{{3.803721796100245*^9, 3.803721870534019*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Goal", "Section",
 CellChangeTimes->{{3.8037220922622337`*^9, 3.803722177398147*^9}, {
  3.80372220920725*^9, 3.80372221021809*^9}, {3.8037231234395933`*^9, 
  3.803723164735446*^9}}],

Cell[TextData[{
 "The goal of my project was to implement Level-index Arithmetic using \
Mathematica, so that operations involving huge numbers could be done in the \
future using the Wolfram Language without the general problem of ",
 StyleBox["overflow, e.g., ",
  FontSlant->"Italic"],
 "an operation like below:"
}], "Text",
 CellChangeTimes->{
  3.8037221519698772`*^9, {3.8037221879895372`*^9, 3.803722279018564*^9}, {
   3.803722346652214*^9, 3.8037224427978992`*^9}, {3.803722525628793*^9, 
   3.803722532079068*^9}, {3.8037227477776203`*^9, 3.803722754798015*^9}, {
   3.80372280779777*^9, 3.8037228105713377`*^9}, {3.80372287362681*^9, 
   3.8037228794293203`*^9}, {3.803723085333612*^9, 3.803723092148406*^9}, {
   3.803723427323489*^9, 3.803723438125567*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LevelIndexArithmetic", "[", 
    RowBox[{
     SuperscriptBox["8", 
      SuperscriptBox["88", 
       SuperscriptBox["888", 
        SuperscriptBox[
         SuperscriptBox["50000", 
          SuperscriptBox["69", "233"]], 
         SuperscriptBox["89", 
          SuperscriptBox["64", "23"]]]]]], "+", 
     SuperscriptBox["2", 
      SuperscriptBox["22", 
       SuperscriptBox["222", 
        SuperscriptBox["2222", 
         SuperscriptBox["22222", "222222"]]]]]}], "]"}], "//", "FromLIO"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{
  3.8037228873936243`*^9, {3.803722984651737*^9, 3.80372304095452*^9}},
 CellLabel->"In[35]:="],

Cell[BoxData[
 SuperscriptBox["\<\"10\"\>", 
  SuperscriptBox["\<\"10\"\>", 
   SuperscriptBox["\<\"10\"\>", 
    SuperscriptBox["\<\"10\"\>", 
     SuperscriptBox["\<\"10\"\>", 
      SuperscriptBox["\<\"10\"\>", 
       SuperscriptBox["\<\"10\"\>", 
        SuperscriptBox["\<\"10\"\>", "0.20991937014764134`"]]]]]]]]], "Output",\

 CellChangeTimes->{3.803723052397127*^9, 3.803733380997456*^9, 
  3.803749607346839*^9},
 CellLabel->"Out[35]="]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Research and Implementation ", "Section",
 CellChangeTimes->{{3.803723359607575*^9, 3.803723403212538*^9}, {
  3.803723495809564*^9, 3.803723502780788*^9}, {3.8037248514589*^9, 
  3.803724854039423*^9}}],

Cell[TextData[{
 "\nThe implementation involved careful study of various research papers \
written by ",
 StyleBox["Clenshaw",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Olver",
  FontSlant->"Italic"],
 ", ",
 StyleBox["Turner",
  FontSlant->"Italic"],
 " and ",
 StyleBox["Lozier",
  FontSlant->"Italic"],
 " ",
 ButtonBox[Cell[TextData[StyleBox[ButtonBox["2-3"],
  FontVariations->{"CompatibilityType"->"Superscript"}]], "Citation",
  Editable->False,
  TaggingRules->{$CellContext`NoteData -> {
      RowBox[{
        RowBox[{
          RowBox[{"https", ":"}], "//", 
          RowBox[{
            RowBox[{
              RowBox[{
                RowBox[{"academic", ".", "oup", ".", "com"}], "/", "imajna"}],
               "/", "article"}], "-", 
            RowBox[{
              RowBox[{
                RowBox[{
                  RowBox[{"abstract", "/", "8"}], "/", "4"}], "/", "517"}], 
              "/", 
              RowBox[{"758814", "?", "redirectedFrom"}]}]}]}], "=", 
        "fulltext"}], 
      RowBox[{
        RowBox[{
          RowBox[{"https", ":"}], "//", 
          RowBox[{
            RowBox[{
              RowBox[{"www", ".", "jstor", ".", "org"}], "/", "stable"}], "/", 
            RowBox[{"2157569", "?", "seq"}]}]}], "=", "1"}]}}],
  BaseStyle->"Hyperlink",
  ButtonData->"00005DDD"],
 " ,and inspecting source codes of other open-source calculators currently in \
the market that can compute mathematical operations involving fairly large \
numbers upto a certain degree of precision. However, due to huge \
approximations made in almost all of the existing implemented algorithms,  \
several issues arose out of them in terms of precision and correct results, \
and a real need to do a careful implementation of the core algorithms was \
felt to make the results more accurate.   \n"
}], "Text",
 CellChangeTimes->{{3.8037235504937973`*^9, 3.803723599436604*^9}, {
   3.803723857797967*^9, 3.8037238578254957`*^9}, {3.803723898254364*^9, 
   3.803723898293082*^9}, {3.803724031807281*^9, 3.803724038908386*^9}, 
   3.803724078749854*^9, {3.8037241233864326`*^9, 3.803724203575945*^9}, {
   3.803724249478668*^9, 3.803724266866984*^9}, {3.803724377071446*^9, 
   3.803724532487205*^9}, {3.8037245717900753`*^9, 3.80372477055438*^9}, {
   3.803724835205744*^9, 3.803724838746367*^9}, {3.803724889010903*^9, 
   3.803724891493545*^9}, {3.8037330869649076`*^9, 3.8037330869705553`*^9}, {
   3.803748408803172*^9, 3.8037484170794783`*^9}}],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Functions Implemented",
 FontWeight->"Bold"]], "Subsection",
 CellChangeTimes->{{3.8037249251712523`*^9, 3.803724949470151*^9}, {
  3.80372552369923*^9, 3.803725534593742*^9}}],

Cell[CellGroupData[{

Cell[TextData[{
 "\[FilledDiamond] ",
 StyleBox["ToLIO[",
  FontWeight->"Bold"],
 StyleBox["n_", "Text",
  FontWeight->"Bold"],
 StyleBox["Real", "Text",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 " ",
 StyleBox[": ",
  FontWeight->"Bold"]
}], "Subsubsection",
 CellChangeTimes->{{3.803725540292633*^9, 3.803725597987934*^9}, {
  3.8037258666865892`*^9, 3.803725874079096*^9}, {3.803726203230096*^9, 
  3.803726289334859*^9}}],

Cell[TextData[{
 "The ",
 StyleBox["ToLIO[n_",
  FontWeight->"Bold"],
 StyleBox["Real",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["]",
  FontWeight->"Bold"],
 " function takes any ",
 StyleBox["Real Number",
  FontSlant->"Italic"],
 " as input and converts it into an",
 StyleBox[" LIO[sign, level, index] ",
  FontWeight->"Bold"],
 "object, as per the original Ordinary Level-Index Arithmetic notation of a \
number, having a ",
 StyleBox["sign",
  FontSlant->"Italic"],
 ", a ",
 StyleBox["level",
  FontSlant->"Italic"],
 " and an ",
 StyleBox["index. \nNote: Sign is always either +1 or -1.",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{
  3.803725027132215*^9, {3.80372509220866*^9, 3.803725097306223*^9}, {
   3.803725814543068*^9, 3.803725820459433*^9}, {3.8037258819405403`*^9, 
