Cell[CellGroupData[{

Cell[TextData[{
 "\[FilledDiamond] ",
 StyleBox["PowerForm[ ",
  FontWeight->"Bold"],
 StyleBox["LIO[sign, level, index]", "Text",
  FontWeight->"Bold"],
 StyleBox[" ]",
  FontWeight->"Bold"],
 " ",
 StyleBox[":",
  FontWeight->"Bold"]
}], "Subsubsection",
 CellChangeTimes->{{3.803727114819672*^9, 3.803727195661566*^9}, {
  3.803727814752469*^9, 3.803727817124395*^9}}],

Cell[TextData[{
 "The ",
 StyleBox["PowerForm[LIO[sign,level,index]]",
  FontWeight->"Bold"],
 " function takes any ",
 StyleBox["LIO[sign, level, index] ",
  FontWeight->"Bold"],
 "object as input and converts it into a nice, readable ",
 StyleBox["level-index format ",
  FontSlant->"Italic"],
 " in ",
 StyleBox["base 10, ",
  FontSlant->"Italic"],
 "so that it looks like a ",
 StyleBox["Power Tower",
  FontSlant->"Italic"],
 " of 10s with an index at the end."
}], "Text",
 CellChangeTimes->{{3.803727198303334*^9, 3.803727286715591*^9}, {
  3.8037274044544*^9, 3.803727451491458*^9}, {3.803727485663746*^9, 
  3.803727488993237*^9}}],

