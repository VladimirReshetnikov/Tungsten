        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"begin", "--"}], "--"}], "--"}], "--"}], "--"}], "--"}], 
       "--"}]}]}], "*)"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "ToLIO", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"Precision", "\[Rule]", "MachinePrecision"}], "}"}]}], ";"}], 
   "\n", "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ToLIO", "[", "n_Real", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"in", "=", "n"}], ",", 
         RowBox[{"l", "=", "0"}]}], "}"}], ",", "\n", "\t", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"in", ">=", "1"}], ",", "\n", "\t\t", 
          RowBox[{
           RowBox[{"in", "=", 
            RowBox[{"Log", "[", "in", "]"}]}], ";", "\n", "\t\t", 
           RowBox[{"l", "++"}], ";"}]}], "                         ", "\n", 
         "\t", "]"}], ";", "\n", "\t", 
        RowBox[{"LIO", "[", 
         RowBox[{
          RowBox[{"Sign", "[", "n", "]"}], ",", "l", ",", "in"}], "]"}]}]}], 
      "       ", 
      RowBox[{"(*", 
       RowBox[{"converts", " ", "any", " ", "real", " ", "to", " ", 
        RowBox[{"LIO", "[", 
         RowBox[{"s", ",", "l", ",", "f"}], "]"}]}], "*)"}], "\n", "]"}]}], 
    ";"}], "\n", "\n", "\n", 
   RowBox[{
    RowBox[{"ToLIO", "[", 
     RowBox[{
      RowBox[{"n_", "?", "NumericQ"}], ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
    RowBox[{"ToLIO", "[", 
     RowBox[{"N", "[", 
      RowBox[{"n", ",", 
       RowBox[{"OptionValue", "[", "Precision", "]"}]}], "]"}], "]"}]}], "\n",
    "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PowerForm", "[", 
      RowBox[{"LIO", "[", 
       RowBox[{"s_", ",", "l_", ",", "f_"}], "]"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"res", "=", 
          RowBox[{"LIO", "[", 
           RowBox[{"s", ",", "l", ",", "f"}], "]"}]}], ",", 
         RowBox[{"basecnt", "=", "0"}], ",", "ini", ",", "i"}], "}"}], ",", 
       "\n", "\t", "\n", "\t", 
       RowBox[{
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"res", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], ",", 
          RowBox[{
           RowBox[{"res", "=", 
            RowBox[{"Log10", "[", "res", "]"}]}], ";", 
           RowBox[{"basecnt", "++"}]}]}], "]"}], ";", "\n", "\t", 
        RowBox[{"ini", "=", 
         RowBox[{"Power", "[", 
          RowBox[{"\"\<10\>\"", ",", 
           RowBox[{"res", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", "\n", "\t", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", 
           RowBox[{"basecnt", "-", "1"}]}], ",", 
          RowBox[{"i", "\[GreaterEqual]", "1"}], ",", 
          RowBox[{"i", "--"}], ",", "\n", "\t\t", 
          RowBox[{
           RowBox[{"ini", "=", 
            RowBox[{"Power", "[", 
             RowBox[{"\"\<10\>\"", ",", "ini"}], "]"}]}], ";"}]}], "\n", "\t",
          "]"}], ";", "\n", "\t", "ini"}]}], "\n", "]"}]}], ";"}], "\n", "\n",
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"FromLIO", "[", 
      RowBox[{"LIO", "[", 
       RowBox[{"s_", ",", "l_", ",", "f_"}], "]"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ini", ",", "i"}], "}"}], ",", "\n", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"l", "\[Equal]", "0"}], ",", 
         RowBox[{"Return", "[", "f", "]"}], ",", "\n", "\t", 
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ini", "=", 
              RowBox[{"Power", "[", 
               RowBox[{"\[ExponentialE]", ",", "f"}], "]"}]}], ";", "\n", 
             "\t", 
             RowBox[{"For", "[", 
              RowBox[{
               RowBox[{"i", "=", 
                RowBox[{"l", "-", "1"}]}], ",", 
               RowBox[{"i", "\[GreaterEqual]", "1"}], ",", 
               RowBox[{"i", "--"}], ",", "\n", "\t\t", 
               RowBox[{"ini", "=", 
                RowBox[{"Power", "[", 
                 RowBox[{"\[ExponentialE]", ",", "ini"}], "]"}]}]}], "    ", 
              RowBox[{"(*", 
               RowBox[{"converts", " ", 
                RowBox[{"LIO", "[", 
                 RowBox[{"s", ",", "l", ",", "f"}], "]"}], " ", "to", " ", 
                "powertower", " ", "form", " ", "with", " ", "base", " ", 
                "e"}], "*)"}], "\n", "\t", "]"}], ";", "\n", "\t", "ini"}], 
            ",", 
            RowBox[{"PowerForm", "[", 
             RowBox[{"LIO", "[", 
              RowBox[{"s", ",", "l", ",", "f"}], "]"}], "]"}]}], "]"}]}]}], 
        "\n", "\t", "]"}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"FromLIO", "[", "x_", "]"}], ":=", "x"}], "     ", 
   RowBox[{"(*", 
    RowBox[{"for", " ", "comparisons"}], "*)"}], "\n", "\n", "\n", "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "LevelIndexArithmetic", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"Precision", "\[Rule]", "MachinePrecision"}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"LevelIndexArithmetic", "[", 
     RowBox[{"expr_", ",", 
      RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Hold", "[", "expr", "]"}], " ", "/.", " ", 
      RowBox[{
       RowBox[{"n_", "?", "AtomicNumberQ"}], " ", ":>", " ", 
       RowBox[{"ToLIO", "[", 
        RowBox[{"N", "[", 
         RowBox[{"n", ",", 
          RowBox[{"OptionValue", "[", "Precision", "]"}]}], "]"}], "]"}]}]}], 
     "//", " ", "ReleaseHold"}]}], "\n", 
   RowBox[{
    RowBox[{"SetAttributes", "[", 
     RowBox[{"LevelIndexArithmetic", ",", " ", "HoldFirst"}], "]"}], ";"}], 
   "   ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Final", " ", "function", " ", "to", " ", "perform", " ", "an", " ", 
