Cell[CellGroupData[{

Cell["Summary", "Section",
 CellChangeTimes->{{3.8037323374561367`*^9, 3.8037324039181356`*^9}}],

Cell["\<\
A few functions were successfully fabricated using the Wolfram Language to \
carry out arithmetic operations of huge numbers in Mathematica using \
Level-Index Arithmetic, which would otherwise overflow in normal \
floating-point notation.\
\>", "Text",
 CellChangeTimes->{{3.803732489394549*^9, 3.803732492376011*^9}, {
  3.803732754950727*^9, 3.8037328629968653`*^9}, {3.803748792396048*^9, 
  3.803748812443725*^9}}],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.80373354097449*^9, 3.803733543046085*^9}}]
}, Open  ]],

