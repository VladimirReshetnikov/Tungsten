  FontWeight->"Bold"],
 StyleBox["expr_",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["] ",
  FontWeight->"Bold"],
 "function takes ",
 StyleBox["any arithmetic expression ",
  FontSlant->"Italic"],
 "as input, converts it to ",
 StyleBox["LIO[ sign, level, index] object",
  FontSlant->"Italic"],
 ", performs desired ",
 StyleBox["arithmetic operations",
  FontSlant->"Italic"],
 " on them, and then finally returns the result as an ",
 StyleBox["LIO[ sign, level, index] object",
  FontSlant->"Italic"],
 "."
}], "Text",
